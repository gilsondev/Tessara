<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tessera.aitokens-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/USR/BIN/python3</string>
    <string>/ABS/PATH/todoist-panel/tools/aitokens_bridge/bridge.py</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/tessera-aitokens-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/tessera-aitokens-bridge.log</string>
</dict>
</plist>
