{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tessara",
  "version": "0.1.0",
  "identifier": "dev.tessara.agent",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tessara",
        "width": 420,
        "height": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: tauri:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:19792 http://localhost:19792; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
